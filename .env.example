# Local or job environment. Never commit real tokens.
YTP_DATABASE=./workdir/publishing.sqlite3
YTP_ASSETS_DIR=./examples/ready
# Set YTP_DRIVE_ROOT_ID to use Google Drive instead of local assets.
# YTP_DRIVE_ROOT_ID=
YTP_TOKEN_FILE=./secrets/token.json
YTP_OAUTH_CLIENT_FILE=./secrets/client_secret.json
# The channel ID must match the OAuth account's active channel.
# YTP_YOUTUBE_CHANNEL_ID=
