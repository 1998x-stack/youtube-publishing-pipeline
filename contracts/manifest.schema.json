{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublishingManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "title",
    "description",
    "video_file",
    "target_channel",
    "publish_at",
    "ready",
    "review_approved",
    "rights_confirmed",
    "made_for_kids",
    "contains_synthetic_media"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 5000
    },
    "video_file": {
      "$ref": "#/$defs/safe_filename"
    },
    "thumbnail_file": {
      "$ref": "#/$defs/safe_filename"
    },
    "subtitle_file": {
      "$ref": "#/$defs/safe_filename"
    },
    "subtitle_language": {
      "type": "string",
      "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$"
    },
    "tags": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "category_id": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "target_channel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "publish_at": {
      "type": "string",
      "format": "date-time"
    },
    "ready": {
      "type": "boolean"
    },
    "review_approved": {
      "type": "boolean"
    },
    "rights_confirmed": {
      "type": "boolean"
    },
    "made_for_kids": {
      "type": "boolean"
    },
    "contains_synthetic_media": {
      "type": "boolean"
    }
  },
  "$defs": {
    "safe_filename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^/\\\\]+$"
    }
  }
}
